# Copy this file to .env and fill in the values. Never commit your real .env file.

# LLM provider: "openai" or "groq"
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-buraya_anahtarini_yaz

# Required only when LLM_PROVIDER=groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_buraya_anahtarini_yaz

# Chat model. Defaults: openai -> gpt-4o-mini, groq -> openai/gpt-oss-120b
LLM_MODEL_NAME=gpt-4o-mini

# Local models (downloaded automatically on first run)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# Chunking and retrieval
CHUNK_SIZE=512
SIMILARITY_TOP_K=60
RERANK_TOP_N=5

# Paths (relative to the project root)
DATA_FILE=data/raw
VECTOR_DB_FILE=vector_db
